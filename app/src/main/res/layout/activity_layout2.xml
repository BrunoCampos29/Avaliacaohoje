<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LayoutActivity2">

    <ImageView
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/outline_arrow_back_"
        android:layout_margin="10dp"/>

    <TextView
        android:layout_centerHorizontal="true"
        android:id="@+id/menupricipal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MENU"
        android:textSize="30dp"
        android:layout_margin="10dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card1"
        android:layout_below="@id/menupricipal"
        android:layout_width="150dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#654354"
        android:layout_margin="28dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card2"
        android:layout_toRightOf="@id/card1"
        android:layout_below="@id/menupricipal"
        android:layout_width="150dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#654354"
        android:layout_margin="28dp"/>




    <androidx.cardview.widget.CardView
        android:id="@+id/card3"
        android:layout_below="@id/card1"
        android:layout_width="150dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#654354"
        android:layout_margin="28dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card4"
        android:layout_toRightOf="@id/card3"
        android:layout_below="@id/card2"
        android:layout_width="150dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#654354"
        android:layout_margin="28dp"/>




    <androidx.cardview.widget.CardView
        android:id="@+id/card5"
        android:layout_below="@id/card3"
        android:layout_width="150dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#654354"
        android:layout_margin="28dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/card6"
        android:layout_toRightOf="@id/card5"
        android:layout_below="@id/card4"
        android:layout_width="150dp"
        android:layout_height="200dp"
        app:cardBackgroundColor="#654354"
        android:layout_margin="28dp"/>




</RelativeLayout>